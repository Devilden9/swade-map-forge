InitiativeEntry(){return initCurrent()}
function jokerAvailableEntries(){
 return initDrawn.map((x,i)=>({...x,_i:i})).filter(x=>isJokerCard(x.card)&&!jokerUsed.includes(x._i));
}
function refreshJokerControls(){
 const btn=document.querySelector("#jokerInterrupt"),hint=document.querySelector("#jokerBonusHint");
 if(!btn||!hint)return;
 const cur=initCurrent(),available=jokerAvailableEntries();
 const jokerActive=cur&&isJokerCard(cur.card);
 hint.classList.toggle("hidden",!jokerActive);
 const bonusBox=document.querySelector("#initiativeRollBonus"),bonusValue=document.querySelector("#initiativeRollBonusValue");
 if(bonusBox&&bonusValue){
   bonusBox.classList.toggle("hidden",!cur);
   if(cur){
     const n=initiativeRollModifier(cur.card);
     bonusValue.textContent=initiativeModifierText(cur.card);
     bonusBox.classList.toggle("positive",n>0);
     bonusBox.classList.toggle("negative",n<0);
   }
 }
 // Local draft: GM may trigger any available Joker. In multiplayer this will later be
 // server-authoritative and restricted to the owner.
 const canInterrupt=available.some(j=>!cur||j._i!==cur._i);
 btn.classList.toggle("hidden",!canInterrupt);
}
function initCurrent(){
 const order=initTurnOrder();
 return initTurnIndex>=0&&initTurnIndex<order.length?order[initTurnIndex]:null;
}
function combatRefreshActiveToken(){
 document.querySelectorAll(".activeTurnRing").forEach(e=>e.remove());
 const cur=initCurrent(),host=document.querySelector("#map");
 if(cur&&cur.tokenId&&host){
   const tok=(state.items||[]).find(t=>t.id===cur.tokenId&&t.type==="token");
   if(tok){
     const ring=document.createElement("div");ring.className="activeTurnRing";
     ring.style.left=(Number(tok.x)-4)+"px";ring.style.top=(Number(tok.y)-4)+"px";
     ring.style.width=(Number(tok.w||state.cell)+8)+"px";ring.style.height=(Number(tok.h||state.cell)+8)+"px";
     host.appendChild(ring);
   }
 }
 const r=document.querySelector("#combatRound");if(r)r.textContent=combatRound;
}
function initLabel(c){return c.joker?"JOKER 🃏":c.rank+c.suit}
function initShow(c){
 const el=$("#initCard");el.className="initCard";
 if(!c){$("#initA").textContent=$("#initB").textContent="—";$("#initSuit").textContent="?";return}
 if(c.joker){el.classList.add("joker");$("#initA").textContent=$("#initB").textContent="JOKER";$("#initSuit").textContent="🃏";return}
 if(c.suit==="♥"||c.suit==="♦")el.classList.add("red");
 $("#initA").innerHTML=$("#initB").innerHTML=c.rank+"<br>"+c.suit;$("#initSuit").textContent=c.suit;
}
function initRenderRows(){
 const order=initTurnOrder(),cur=initCurrent();
 $("#initRows").innerHTML=order.length?order.map(x=>{
   const active=cur&&cur._i===x._i,held=heldTurns.includes(x._i);
   return `<div class="initRow ${active?"currentTurn":""} ${held?"heldTurn":""} ${isJokerCard(x.card)?"jokerOwner":""} ${active&&isJokerCard(x.card)?"jokerTurn":""}"><span>${x.tokenId?"● ":""}${x.name}${active?'<span class="initTurnTag">← ХОД</span>':""}${held?'<span class="initTurnTag">⏸ УДЕРЖИВАЕТ</span>':""}</span><span class="initVal ${(x.card.suit==="♥"||x.card.suit==="♦")?"initRed":""}">${initLabel(x.card)}</span></div>`;
 }).join(""):'<div class="initRow"><span>Карты ещё не вытягивались</span><span>—</span></div>';
 combatRefreshActiveToken();
}
function initStatus(){$("#initCount").textContent=`В колоде: ${initDeck.length} · сейчас тянет: ${initNames[initNameIndex]}`}
function initFresh(){
 initDeck=[];for(const suit of initSuits)for(const rank of initRanks)initDeck.push({rank,suit});initDeck.push({joker:true},{joker:true});
 for(let i=initDeck.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[initDeck[i],initDeck[j]]=[initDeck[j],initDeck[i]]}
 initDrawn=[];initTurnIndex=-1;heldTurns=[];initShow(null);initRenderRows();initStatus();
}
function initTake(name,tokenId=null){
 if(!initDeck.length){alert("Колода закончилась. Нажмите «Новая колода».");return null}
 const card=initDeck.pop();initDrawn.push({name,card,tokenId});initTurnIndex=0;initShow(card);return card;
}
function initNpcCandidates(){
 const items=Array.isArray(state.items)?state.items:[];
 return items.filter(t=>t && t.type==="token");
}
function initCardForToken(id){
 const found=[...initDrawn].reverse().find(x=>x.tokenId===id);
 return found?found.card:null;
}
function initRefreshNpcTokens(){
 const box=document.querySelector("#initNpcTokens"); if(!box)return;
 const tokens=initNpcCandidates();
 if(!tokens.length){
   box.innerHTML='<div style="padding:5px">На карте пока нет токенов.</div>';
   return;
 }
 box.innerHTML=tokens.map(t=>{
   const c=initCardForToken(t.id);
   const card=c?initLabel(c):"—";
   const red=c&&c.suit&&"♥♦".includes(c.suit)?"color:#d56b6b":"";
   return `<div style="display:grid;grid-template-columns:1fr auto auto;gap:7px;align-items:center;padding:6px 3px;border-bottom:1px solid #292f37">
     <span>● ${escapeHtml(t.name||"PC")}</span>
     <b style="font-family:Georgia;${red}">${card}</b>
     <button class="initTokenDraw" data-token="${escapeHtml(t.id)}" style="padding:5px 7px">Тянуть</button>
   </div>`;
 }).join("");
 box.querySelectorAll(".initTokenDraw").forEach(btn=>btn.addEventListener("click",()=>{
   const id=btn.dataset.token;
   const token=(state.items||[]).find(t=>t.id===id&&t.type==="token");
   if(!token)return;
   initDrawn=initDrawn.filter(x=>x.tokenId!==id);
   if(initTake(token.name||"PC",id)){initRenderRows();initStatus();initRefreshNpcTokens()}
 }));
}$("#initDraw").addEventListener("click",()=>{if(initTake(initNames[initNameIndex])){initRenderRows();initStatus()}});
$("#initNext").addEventListener("click",()=>{initNameIndex=(initNameIndex+1)%initNames.length;initStatus()});
$("#initReset").addEventListener("click",initFresh);
$("#initEndTurn").addEventListener("click",()=>{
 let order=initTurnOrder();
 if(!order.length)return alert("Сначала вытяните карты инициативы.");
 const before=initCurrent();
 if(before&&isJokerCard(before.card)){
   if(!jokerUsed.includes(before._i))jokerUsed.push(before._i);
   if(interruptedTurnStack.length){
     const restore=interruptedTurnStack.pop();
     order=initTurnOrder();
     initTurnIndex=order.findIndex(x=>x._i===restore);
   }else{
     if(initTurnIndex<order.length-1)initTurnIndex++; else {$("#initEndTurn").textContent="↻ Новый раунд";return;}
   }
 }else if(initTurnIndex<0)initTurnIndex=0;
 else if(initTurnIndex<order.length-1)initTurnIndex++;
 else {
   $("#initEndTurn").textContent="↻ Новый раунд";
   return;
 }
 const cur=initCurrent();
 if(cur&&cur.tokenId){
   selected=cur.tokenId;
   const tok=(state.items||[]).find(t=>t.id===cur.tokenId);
   if(tok){
     panX=stage.clientWidth/2-(tok.x+tok.w/2)*zoom;
     panY=stage.clientHeight/2-(tok.y+tok.h/2)*zoom;
     originalRender();
   }
 }
 initRenderRows();initRefreshNpcTokens();refreshTokenConditions();
});
$("#initNpcDeal").addEventListener("click",()=>{
 const tokens=initNpcCandidates();
 if(!tokens.length)return alert("На карте нет токенов.");
 for(const token of tokens){
   initDrawn=initDrawn.filter(x=>x.tokenId!==token.id);
   if(!initTake(token.name||"PC",token.id))break;
 }
 initRenderRows();initStatus();initRefreshNpcTokens();
});

document.querySelectorAll("#extraConditions [data-cond]").forEach(b=>b.addEventListener("click",e=>{
 e.stopPropagation();updateSelectedCondition("condition",b.dataset.cond);
}));

document.querySelector("#jokerInterrupt")?.addEventListener("click",()=>{
 const available=jokerAvailableEntries();
 if(!available.length)return;
 const cur=initCurrent();
 let j=available[0];
 if(available.length>1){
   const names=available.map((x,i)=>`${i+1}. ${x.name}`).join("\n");
   const n=Number(prompt("Кто использует Джокера?\n"+names,"1"))-1;
   if(Number.isInteger(n)&&available[n])j=available[n]; else return;
 }
 if(cur&&cur._i!==j._i)interruptedTurnStack.push(cur._i);
 const order=initTurnOrder();
 initTurnIndex=order.findIndex(x=>x._i===j._i);
 initRenderRows();
 const tok=j.tokenId&&(state.items||[]).find(t=>t.id===j.tokenId);
 if(tok){selected=tok.id;panX=stage.clientWidth/2-(tok.x+tok.w/2)*zoom;panY=stage.clientHeight/2-(tok.y+tok.h/2)*zoom;originalRender();refreshTokenConditions();}
});
document.querySelector("#initHoldTurn")?.addEventListener("click",()=>{
 const cur=initCurrent();if(!cur)return alert("Сейчас нет активного хода.");
 if(!heldTurns.includes(cur._i))heldTurns.push(cur._i);
 $("#initEndTurn").click();
});
document.querySelector("#initNewRound")?.addEventListener("click",()=>{
 combatRound++;heldTurns=[];interruptedTurnStack=[];jokerUsed=[];initTurnIndex=-1;initDrawn=[];
 initFresh();$("#initEndTurn").textContent="✓ Завершить ход";
 const r=document.querySelector("#combatRound");if(r)r.textContent=combatRound;
});
document.querySelector("#floatWoundMinus")?.addEventListener("click",e=>{e.stopPropagation();updateSelectedCondition("wounds",-1)});
document.querySelector("#floatWoundPlus")?.addEventListener("click",e=>{e.stopPropagation();updateSelectedCondition("wounds",1)});
document.querySelector("#floatShaken")?.addEventListener("click",e=>{e.stopPropagation();updateSelectedCondition("shaken",0)});
document.querySelector("#woundMinus")?.addEventListener("click",()=>updateSelectedCondition("wounds",-1));
document.querySelector("#woundPlus")?.addEventListener("click",()=>updateSelectedCondition("wounds",1));
document.querySelector("#shakenToggle")?.addEventListener("click",()=>updateSelectedCondition("shaken",0));
document.addEventListener("pointerup",()=>setTimeout(()=>{refreshTokenConditions();renderTokenConditionBadges()},0));
initFresh();
initRefreshNpcTokens();
refreshTokenConditions();
renderTokenConditionBadges();



// --- Map image upload (local draft) ---
const imageUploadBtn=document.querySelector("#imageUploadBtn");
const imageFile=document.querySelector("#imageFile");
if(imageUploadBtn && imageFile){
  imageUploadBtn.addEventListener("click",()=>imageFile.click());
  imageFile.addEventListener("change",()=>{
    const file=imageFile.files && imageFile.files[0];
    if(!file)return;
    if(!(file.type||"").startsWith("image/")){
      alert("Выберите файл изображения.");
      imageFile.value="";
      return;
    }
    const reader=new FileReader();
    reader.onload=()=>{
      const data=String(reader.result||"");
      const probe=new Image();
      probe.onload=()=>{
        state.mapImage=data;
        // Keep current width, adapt map height to the image aspect ratio.
        if(probe.naturalWidth && probe.naturalHeight && state.cols){
          state.rows=Math.max(1,Math.round(state.cols*probe.naturalHeight/probe.naturalWidth));
        }
        render();
        imageFile.value="";
      };
      probe.onerror=()=>{alert("Браузер не смог открыть это изображение.");imageFile.value=""};
      probe.src=data;
    };
    reader.onerror=()=>{alert("Не удалось прочитать файл.");imageFile.value=""};
    reader.readAsDataURL(file);
  });
}


// --- Local battle autosave ---
const LOCAL_SAVE_KEY="swade-map-forge-battle-draft-v1";
function saveBattleLocal(){
 try{
   localStorage.setItem(LOCAL_SAVE_KEY,JSON.stringify({state,initDrawn,initTurnIndex,combatRound,heldTurns,interruptedTurnStack,jokerUsed,panX,panY,zoom}));
 }catch(e){}
}
function loadBattleLocal(){
 try{
   const raw=localStorage.getItem(LOCAL_SAVE_KEY);if(!raw)return;
   const d=JSON.parse(raw);
   if(d.state&&confirm("Найдено автосохранение этой карты. Восстановить?")){
     state=d.state;initDrawn=d.initDrawn||[];initTurnIndex=Number.isInteger(d.initTurnIndex)?d.initTurnIndex:-1;
     combatRound=d.combatRound||1;heldTurns=d.heldTurns||[];interruptedTurnStack=d.interruptedTurnStack||[];jokerUsed=d.jokerUsed||[];panX=d.panX||0;panY=d.panY||0;zoom=d.zoom||1;
     render();initRenderRows();initRefreshNpcTokens();
   }
 }catch(e){}
}
setInterval(saveBattleLocal,5000);
window.addEventListener("beforeunload",saveBattleLocal);
setTimeout(loadBattleLocal,100);

</script>
</body>
</html>